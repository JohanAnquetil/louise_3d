 </node>
 <node id="5197555830" visible="true" version="6" changeset="164744835" timestamp="2025-04-09T22:25:56Z" user="pyrog" uid="270456" lat="48.8688696" lon="2.3673736">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Destinés à prolonger le canal de l'Ourcq, le canal de Saint-Denis et le canal Saint-Martin offraient une voie de navigation de Seine à Seine qui permettait aux embarcations un gain de 12 km sur le trajet. Si le canal Saint-Denis est en majeure partie"/>
  <tag k="inscription:2" v="situé hors de Paris, le canal Saint-Martin traverse le 10e arrondissement de part en part: il constituait non seulement une voie de transport fluvial, mais aussi un embellissement pour la capitale. Commencés sous l'Empire, ses travaux s'achevèrent sous"/>
  <tag k="inscription:3" v="la Restauration, en 1825. Du bassin de la Villette à celui de l'Arsenal, avec un coude d'une longueur de 4,5 km pour contourner l'hôpital Saint-Louis, il nécessita neuf écluses pour racheter une dénivellation de 25 m. Primitivement à ciel ouvert, il"/>
  <tag k="inscription:4" v="présentait le grave inconvénient d'isoler de la ville tous les quartiers situés entre son tracé et les boulevards extérieurs; sous le Second Empire, il fut voûté partiellement en amont de la place de la Bastille. La largeur du plan d'eau est de 27 m, sa"/>
  <tag k="inscription:5" v="profondeur de 2 m."/>
  <tag k="name" v="Canal Saint-Martin"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="panoramax" v="67e501fd-c0b7-4213-b59d-ea3b1caa5e13;4364f8dd-12bb-4e5f-a131-d9e35c7d68f9"/>
  <tag k="subject:wikidata" v="Q860172"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60292406"/>
  <tag k="wikimedia_commons" v="File:Canal-Saint-Martin.jpg"/>
 </node>
 <node id="5197555831" visible="true" version="3" changeset="103291483" timestamp="2021-04-20T19:18:51Z" user="Britzz" uid="7550430" lat="48.8685032" lon="2.3700108">
  <tag k="board_type" v="history"/>
  <tag k="historic" v="memorial"/>
  <tag k="information" v="board"/>
  <tag k="inscription:1" v="Dans le rue de la Fontaine-au-Roi résista la dernière barricade de la Commune de Paris défendue par ses chefs: E. VARLIN, T. FERRE et J.B. CLEMENT. Elle succomba vers midi le 28 mai 1871 au terme de la &quot;Semaine Sanglante&quot;. 120 ans après, le Parti"/>
  <tag k="inscription:2" v="Socialiste et son Premier Secrétaire Pierre MAUROY, rendent hommage au Peuple de PARIS qui voulut changer la vie et aux 30.000 fusillés du &quot;temps des cerises&quot;. 28 mai 1871 / 28 mai 1991."/>
  <tag k="memorial" v="plaque"/>
  <tag k="wikidata" v="Q42401130"/>
 </node>
 <node id="5197569908" visible="true" version="6" changeset="168805799" timestamp="2025-07-11T16:40:11Z" user="Britzz" uid="7550430" lat="48.8667374" lon="2.3656222">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="ICI EST TOMBÉ LOUIS COSSON DU GROUPE PH 35 DES CORPS-FRANCS DE LA DELEGATION GÉNÉRALE DU GOUVERNEMENT PROVISOIRE MORT POUR LA FRANCE LE 25 AOUT 1944"/>
  <tag k="memorial" v="plaque"/>
  <tag k="survey:date" v="2025-07-11"/>
 </node>
 <node id="5197569909" visible="true" version="4" changeset="168805799" timestamp="2025-07-11T16:40:11Z" user="Britzz" uid="7550430" lat="48.8667397" lon="2.3656242">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="DANS CET IMMEUBLE JEAN PONSARD 24 AND SAPEUR POMPIER ROBERT KALMAN 21 ANS FFI ONT ÉTÉ TUÉS PAR LES ALLEMANDS LE 25 AOUT 1944 EN LUTTANT POUR LA LIBÉRATION DE PARIS."/>
  <tag k="memorial" v="plaque"/>
 </node>
 <node id="5198050773" visible="true" version="5" changeset="164697799" timestamp="2025-04-08T21:02:43Z" user="pyrog" uid="270456" lat="48.8679943" lon="2.3642020">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2023-10-09"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Cette place correspond au bastion de la porte du Temple dans l'enceinte de Charles V (XIVe siècle). Ornée en 1811 de la fontaine du Château d'Eau, elle prit sa physionomie actuelle sous le Second Empire, avec le percement du boulevard de Magenta et du"/>
  <tag k="inscription:2" v="boulevard du Prince-Eugène, aujourd'hui dédié à Voltaire. Gabriel Davioud, architecte de la Ville de Paris, construisit la caserne qui remplace l'ancien Wauxhall, et le diorama de Daguerre, ainsi que les magasins réunis. En 1879, un concours, organisé"/>
  <tag k="inscription:3" v="pour l'installation d'un grand monument consacré à la République, fut remporté par les frères Morice, Léopold pour la statuaire et Charles pour le soubassement. La cérémonie d'inauguration eut lieu le 14 juillet 1883."/>
  <tag k="name" v="Place de la République"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q175055"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60291715"/>
  <tag k="wikimedia_commons" v="File:Republique pelle.jpg;File:Republique situation.jpg"/>
 </node>
 <node id="5198050774" visible="true" version="3" changeset="164697799" timestamp="2025-04-08T21:02:43Z" user="pyrog" uid="270456" lat="48.8674274" lon="2.3651683">
