 <node id="14277443507" visible="true" version="1" changeset="190410980" timestamp="2026-10-12T16:18:48Z" user="Kalepom" uid="392288" lat="48.8725882" lon="2.3711395">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="À la mémoire des habitants de cet immeuble traqués et déportés de 1941 à 1944 parce que nés juifs et de ceux, parmi leurs voisins, qui eurent le courage de résister à cette barbarie."/>
  <tag k="memorial" v="plaque"/>
 </node>
 <node id="14277467614" visible="true" version="2" changeset="190410732" timestamp="2026-10-12T16:24:05Z" user="Kalepom" uid="392288" lat="48.8718928" lon="2.3719811">
