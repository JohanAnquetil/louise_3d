  <tag k="memorial" v="plaque"/>
  <tag k="tourism" v="information"/>
 </node>
 <node id="5117266279" visible="true" version="5" changeset="164744835" timestamp="2025-04-09T22:25:56Z" user="pyrog" uid="270456" lat="48.8693030" lon="2.3807942">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Le métropolitain parisien, encore tout neuf, connut ici, entre les stations Couronnes et Ménilmontant, la première catastrophe de son histoire, le 10 août 1903."/>
  <tag k="inscription:2" v="À l'époque, les wagons étaient en bois, ce soir là, un train prit feu après un court circuit électrique. Les voyageurs, trompés par l'obscurité et la fumée de l'incendie, se bousculèrent pour gagner les sorties;"/>
  <tag k="inscription:3" v="asphixiés ou étouffés contre le mur où ils croyaient trouver une issue, il y eut 84 morts. Cette tragédie frappa très vivement l'opinion publique, tant en France qu'à l'étranger."/>
  <tag k="inscription:4" v="Elle provoqua une réorganisation des normes de sécurité, avec l'installation d'un éclairage de secours indépendant de celui des souterrains et des stations, la création de postes d'incendie dans chaque station,"/>
  <tag k="inscription:5" v="et le remplacement des bancs d'attente par des banquettes fixes."/>
  <tag k="name" v="Catastrophe du 10 Août 1903"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q1069987"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60291980"/>
  <tag k="wikimedia_commons" v="File:Catastrophe 1903.jpg;File:62bdBelleville situ.jpg"/>
 </node>
 <node id="5117266281" visible="true" version="4" changeset="163323419" timestamp="2025-03-07T11:31:50Z" user="Britzz" uid="7550430" lat="48.8717295" lon="2.3820518">
