 <node id="5189353269" visible="true" version="3" changeset="69776032" timestamp="2019-05-01T18:02:30Z" user="Britzz" uid="7550430" lat="48.8695383" lon="2.3885743"/>
 <node id="5192387751" visible="true" version="4" changeset="164611992" timestamp="2025-04-07T00:05:55Z" user="pyrog" uid="270456" lat="48.8734433" lon="2.3641355">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="L'Hôtel du Nord doit sa célébrité au roman homonyme d'Eugène Dabit (1898-1936): il connut dès sa publication en 1929 un grand succès, et valut à son auteur, dont c'était la première œuvre, le Prix du roman populiste. C'est plutôt un recueil de nouvelles:"/>
  <tag k="inscription:2" v="un couple, les Lecouvreur parvient à acheter grâce à un petit héritage un hôtel dont les locataires sont les héros d'une suite d'histoires vraisemblablement vécues. Eugène Dabit a dépeint le Paris populaire cotoyé durant son enfance dans cette pension"/>
  <tag k="inscription:3" v="de mariniers tenue par ses parents. Les héros sont des personnages déracinés, menant un existence difficile. Le seul lien entre eux est cet hôtel qui leur sert de havre; exproprié à la fin du livre il tombe sous la pioche des démolisseurs."/>
  <tag k="inscription:4" v="Malgré l'absence d'intrigue consistante, Marcel Carné à réussi à tirer de ce roman un film tumultueux et singulier. Sorti en 1938, il est aujourd'hui plus célèbre que le roman, grâce au travail du metteur en scène, aux dialogues d'Henri Jeanson, aux"/>
  <tag k="inscription:5" v="décors de Trauner, et à l'interprétation des acteurs, Louis Jouvet et Arletty en tête."/>
  <tag k="name" v="Hôtel du Nord"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q1643166"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60291709"/>
  <tag k="wikimedia_commons" v="File:Hôtel-du-Nord.jpg;File:Hotel du Nord, a Parigi.JPG"/>
 </node>
 <node id="5195985991" visible="true" version="4" changeset="155068412" timestamp="2024-08-10T15:57:23Z" user="baprischka" uid="974272" lat="48.8729609" lon="2.3903447">
