 <node id="11159838416" visible="true" version="3" changeset="165197734" timestamp="2025-04-20T14:40:24Z" user="pyrog" uid="270456" lat="48.8860617" lon="2.3415956">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="« Lorsque le chevalier de La Barre fut convaincu d’avoir changé des chansons impies, et même d’avoir passé devant une procession de capucins sans ôter son chapeau,"/>
  <tag k="inscription:2" v="les juges d’Abbeville ordonnèrent, non seulement qu’on lui arrachât la langue, qu’on lui coupât la main, et qu’on brulât son corps à petit feu,"/>
  <tag k="inscription:3" v="mais l’appliquèrent encore à la torture pour savoir combien de chansons il avait chantées, et combien de processions il avait vues passer, le chapeau sur la tête »."/>
  <tag k="inscription:4" v="Dès 1769, Voltaire s’indigne dans le « Dictionnaire philosophique » du sort réservé à ce jeune homme de 19 ans éxécuté en 1766."/>
  <tag k="inscription:5" v="Les répulicains lui érigent en 1885, sur le parvis de la basilique du Sacré-Coeur, une statue, déplacée ici lors de l’ouverture du square en 1927, et partie à la fonte en 1941."/>
  <tag k="material" v="metal"/>
  <tag k="name" v="La statue du chevalier de la Barre"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q60291926"/>
  <tag k="support" v="pole"/>
  <tag k="survey:date" v="2023-07-21"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60291926"/>
  <tag k="wikimedia_commons" v="File:Chevalier_deLaBarre.jpg;File:Chevalier deLaBarre vue.jpg"/>
 </node>
