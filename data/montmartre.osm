 <node id="5910004120" visible="true" version="5" changeset="165197734" timestamp="2025-04-20T14:40:24Z" user="pyrog" uid="270456" lat="48.8873627" lon="2.3432576">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2024-06-08"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Après l'échec de l'expédition nocturne chargée de s'emparer par surprise des canons de la garde nationale, la première effusion de sang a lieu au soir du 18 mars 1871. Le général Clément Thomas, vieux républicain exilé sous l'Empire et revenu participer"/>
  <tag k="inscription:2" v="à la défense de Paris après Sedan, est reconnu place Pigalle, malgré ses dénégations et son habit civil : il est à la recherche du général Lecomte, retenu par les insurgés depuis le matin, pour avoir donné à la troupe l'ordre de tirer sur la foule."/>
  <tag k="inscription:3" v="Arrêté lui aussi, il est conduit au siège du Comité central situé au 6, rue des Rosiers (rebaptisée en 1907 rue du Chevalier de La Barre). Condamnés à mort par un jugement sommaire, tous deux sont passés par les armes contre le mur du jardin par leurs"/>
  <tag k="inscription:4" v="propres soldats."/>
  <tag k="name" v="La fusillade du 18 Mars 1871"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q3491712"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60291921"/>
  <tag k="wikimedia_commons" v="File:Fusillade 18mars1871.jpg;File:P1270014 Paris XVIII rue du Chevalier-de-la-Barre rwk.jpg"/>
 </node>
