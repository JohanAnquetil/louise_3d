 <node id="5280543466" visible="true" version="6" changeset="165197734" timestamp="2025-04-20T14:40:24Z" user="pyrog" uid="270456" lat="48.8834668" lon="2.3422105">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Pour avoir apporté à Louis XVIII un témoignage indiscutable de la mort du dauphin Louis XVII, Seveste se voit offrir en récompense la concession des théâtres situés au-delà des barrières de la capitale :"/>
  <tag k="inscription:2" v="il fait ainsi construire le Théâtre de Montmartre, ouvert en 1822. Le mélodrame romantique, l’opérette et l’opéra-bouffe y alternent tout au long du XIXe siècle,"/>
  <tag k="inscription:3" v="jusqu’à l’arrivée de Charles Dullin, rénovateur de talent, qui le transforme en 1922 en Théâtre de l’Atelier ; en 1930, Jean-Jouis Barrault y fait ses débuts d’acteur."/>
  <tag k="inscription:4" v="De 1949 à 1973, André Barsacq assure la succession de Dullin. La façade et le foyer, témoins de l’architecture romantique,"/>
  <tag k="inscription:5" v="et la place du Théâtre porte depuis 1957 le nom de Charles Dullin (1885 – 1949)."/>
  <tag k="name" v="Le Théâtre de l'Atelier"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q3527666"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60291942"/>
  <tag k="wikimedia_commons" v="File:Théâtre Atelier.jpg;File:ThéâtreAtelier situ.jpg"/>
 </node>
 <node id="5280556722" visible="true" version="5" changeset="165197734" timestamp="2025-04-20T14:40:24Z" user="pyrog" uid="270456" lat="48.8844341" lon="2.3433494">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2023-04-19"/>
  <tag k="historic" v="memorial"/>
  <tag k="information" v="board"/>
  <tag k="inscription:1" v="Imaginé par Charles Alphand et orchestré par Jean-Camille Formingé, l’aménagement du square date de 1880."/>
  <tag k="inscription:2" v="L’ouverture fut retardée par des glissements de terrains dus à la présence de carrières de gypse. Il porte le nom de Louise Michel, dite la Vierge Rouge, figure de la Commune de Paris."/>
  <tag k="inscription:3" v="Il est orné de deux fontaines, l’une du sculpteur Derre : la fontaine des Innocents (1907), l’autre de Paul Gasq, dédiée aux dieux marins (1932)."/>
  <tag k="inscription:4" v="On y trouve pommiers et poiriers à fleurs, érables, ptérocaryas, frênes, noyers, cédrèles, ormes, micocouliers, arbres de Judée, robiniers, sorbiers, savonniers, hêtres…"/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Square Louise-Michel"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q216092"/>
  <tag k="tourism" v="information"/>
  <tag k="wikimedia_commons" v="File:Panneau Square Louise Michel - Paris XVIII (FR75) - 2021-08-03 - 1.jpg"/>
 </node>
 <node id="5280576098" visible="true" version="7" changeset="165197734" timestamp="2025-04-20T14:40:24Z" user="pyrog" uid="270456" lat="48.8860780" lon="2.3427355">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="En juillet 1873, l’Assemblée nationale déclare d’utilité publique la basilique que l’archevêque de Paris propose d’élever, par souscription nationale, au sommet de la colline de Montmartre,"/>
  <tag k="inscription:2" v="« en l’honneur du Sacré-Cœur de Jésus-Christ, pour appeler sur la France, et en particulier sur la capitale, la miséricorde et la protection divines »."/>
  <tag k="inscription:3" v="Ainsi se concrétise le « Voeu national » lancé en 1870 pour la délivrance du pape et le salut de la France. Pie IX venait d’instituer la fête du Sacré-Cœur en 1856, cédant aux instances des Jésuites."/>
  <tag k="inscription:4" v="La première pierre du colossal édifice est posée en 1875, sur l’emplacement du parc d’artillerie, et sa construction ‘achève laborieusement : sa consécration a seulement lieu le 16 octobre 1919."/>
  <tag k="name" v="La basilique du Sacré-Cœur"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q28785"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60291918"/>
  <tag k="wikimedia_commons" v="File:Panneau 18e La basilique du Sacre-Coeur.jpg"/>
 </node>
 <node id="5280576100" visible="true" version="6" changeset="164677926" timestamp="2025-04-08T12:40:43Z" user="pyrog" uid="270456" lat="48.8862190" lon="2.3415595">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2024-05-21"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="En mars 1871, la situation est explosive dans la capitale. Durement ressentie après les souffrances endurées au cours des cinq mois du siège,"/>
  <tag k="inscription:2" v="l’humiliation de la défaite est venue s’ajouter aux maladresses de l’Assemblée à majorité monarchiste, élue en février, qui décide de s’installer à Versailles."/>
  <tag k="inscription:3" v="À l’aube du 18 mars, sur ordre de Thiers, l’armée tente de s’emparer par surprise des 227 canons de la garde nationale."/>
  <tag k="inscription:4" v="Mal conçue, la manœuvre échoue, faute d’attelages en nombre suffisant ; la foule rassemblée fraternise avec la troupe, qui désarme ses officiers. À neuf heures du matin,"/>
  <tag k="inscription:5" v="la partie est perdue pour le gouvernement, et le Comité central de la garde nationale prend le pouvoir. Marquée d’un double caractère patriotique et révolutionnaire, la Commune vient de naître."/>
  <tag k="name" v="Le parc d’artillerie de Montmartre"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q133132"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60291938"/>
  <tag k="wikimedia_commons" v="File:Panneau Parc d'artillerie de Montmartre.jpg;File:P1210472 Paris XVIII rue Azaïs rwk.jpg"/>
 </node>
 <node id="5290563510" visible="true" version="4" changeset="164677926" timestamp="2025-04-08T12:40:43Z" user="pyrog" uid="270456" lat="48.8879519" lon="2.3396919">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2023-07-17"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Né rue du Poteau en 1883, il est le fils de Suzanne Valadon (1887-1938), une acrobate et modèle encouragée par Degas, Toulouse-Lautrec et Renoir à développer un puissant talent expressionniste. Après un premier internement à Saint-Anne dès 1900, sa mère"/>
  <tag k="inscription:2" v="l'initie à la peinture sur le conseil des médecins. Aussi attachée au décor urbain que Valadon au portrait, Utrillo rompt avec la tradition paysagiste pour créer une poétique de la ville irisée de la mélancolie : l'essentiel de son oeuvre est une"/>
  <tag k="inscription:3" v="description des rues de Montmartre, animée d'un soucis de perfection dans le réalisme proche des peintres naïfs. Malgré sa légende de peintre maudit, il connait le succès à partir de 1919. Depuis 1955, il repose au cimetière Saint-Vincent, entre sa mère"/>
  <tag k="inscription:4" v="et sa compagne, Lucie Valore."/>
  <tag k="name" v="La maison rose de Maurice Utrillo"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q108301"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60291924"/>
  <tag k="wikimedia_commons" v="File:Panneau Maison Rose Utrillo.jpg;File:Maison-Rose.jpg"/>
 </node>
 <node id="5290563511" visible="true" version="4" changeset="190203578" timestamp="2026-10-08T14:16:15Z" user="Tachymetrus" uid="20180408" lat="48.8874796" lon="2.3416262">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2026-10-08"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Autrefois appelé square du Mont-Cenis, ce jardin porte, depuis 2012, le nom de Claude Charpentier (1909-1995), architecte font l'action fut déterminante dans l'élaboration de la loi Mairaux (1962) avec la protection de secteurs sauvegardés à Paris :"/>
  <tag k="inscription:2" v="Montmartre, les Halles, le Marais, les rives de la Seine, le quartier Maubert. Il restaura le Bateau lavoir et construisit le Conservatoire de musique du 18e arrondissement."/>
  <tag k="inscription:3" v="Claude Charpentier était également contrebassiste et chef d'orchestre au Violon d'Ingres."/>
  <tag k="name" v="Square Claude-Charpentier"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q3495043"/>
  <tag k="subject:wikipedia" v="fr:Square Claude-Charpentier"/>
  <tag k="tourism" v="information"/>
 </node>
 <node id="5290563512" visible="true" version="1" changeset="54715767" timestamp="2017-12-17T22:38:12Z" user="ahstam" uid="2804992" lat="48.8871803" lon="2.3413370">
  <tag k="board_type" v="history"/>
  <tag k="historic" v="memorial"/>
  <tag k="information" v="board"/>
  <tag k="inscription:1" v="Ici se situait l'un des plus célèbres établissement de divertissement parisien des années 50 et 60. Y chantèrent PATACHOU elle-même, Hugues AUFRAY, Charles AZNAVOUR, Guy BÉART, Jacques BREL, Sammy DAVIS Jr., Raymond DEVOS, Léo FERRÉ, Dean MARTIN, Claude"/>
  <tag k="inscription:2" v="NOUGARO, Frank SINATRA... Georges BRASSENS y lança sa carrière. Edith PIAF y fit sa dernière représentation publique. Le cabaret était connu aussi pour son ambiance festive où l'on coupait les cravates. À l'emplacement même de l'ancien cabaret de"/>
  <tag k="inscription:3" v="Patachou se trouve la galerie Roussard."/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Le cabaret de Patachou"/>
 </node>
 <node id="5290563513" visible="true" version="6" changeset="165197734" timestamp="2025-04-20T14:40:24Z" user="pyrog" uid="270456" lat="48.8865460" lon="2.3413334">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Le 12 novembre 1789, l'Assemblée nationale décrète la création d'une municipalité dans chaque ville, bourg ou paroisse. La commune de Montmartre voir le jour en mars 1790, non sans difficulté : en effet, la construction du mur de l'octroi vient de couper"/>
  <tag k="inscription:2" v="le village en deux. Le Haut-Montmartre élit son propre conseil, présidé par un farouche partisan de la séparation, entérinée le 22 juin 1790; la municipalité de Paris absorbe le Bas-Montmartre. Né a Rouen, Félix Desportes habite placedu Tertre depuis"/>
  <tag k="inscription:3" v="1788 : animé d'un grand zèle patriotique, ce gestionnaire avisé transforme son domicile en hôtel de la Mairie, et, jusqu'en avril 1793, établit solidement l'institution municipale. Devenu père en mai 1791, il donne à sa fille les prénoms de Flore,"/>
  <tag k="inscription:4" v="Pierrette, Montmartre..."/>
  <tag k="material" v="metal"/>
  <tag k="name" v="Mairie de Montmartre"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q60367091"/>
  <tag k="support" v="pole"/>
  <tag k="survey:date" v="2023-07-21"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60291945"/>
  <tag k="wikimedia_commons" v="File:Montmartre_mairie.jpg;File:Mairie de Montmartre R Saint-Éleuthère IMG 4085.jpg"/>
 </node>
 <node id="5290571509" visible="true" version="4" changeset="164677926" timestamp="2025-04-08T12:40:43Z" user="pyrog" uid="270456" lat="48.8885629" lon="2.3399308">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2024-09-01"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Vers 1860, le Cabaret des Assassins offre aux parisiens en mal de pittoresque sa terrasse accueillante, ombragée d'un grand acacia, et son petit vin clairet transformé en auberge en 1886 par une ancienne danseuse fin cordon bleu, il reçoit parmi ses"/>
  <tag k="inscription:2" v="habitués Alphonse Allais, Caran d'Ache ou André Gill. Ce dernier décore la façade d'un lapin facétieux bondissant d'une casserole, et l'habitude se prend de désigner l’établissement sous le nom de &quot;Lapin à Gill&quot;, vite déformé en &quot;Lapin Agile&quot;."/>
  <tag k="inscription:3" v="Racheté en 1902 par Aristide Bruant, il est confié à un couple de gérants, Berthe et Frédé, célèbres pour la générosité de leur accueil aux rapins désargentés, Picasso, Modigliani, Utrillo... Même l'âne, Lolo, connait son heure de gloire au Salon des"/>
  <tag k="inscription:4" v="Indépendants de 1910 sous le pseudonyme de Boronali, transparent anagramme d'Aliboron; il est l'auteur d'une &quot;Coucher de soleil sur l'Adriatique&quot;, réalisé grâce à l'immersion de son appendice caudal dans différents pots de couleur..."/>
  <tag k="inscription:5" v="L'inspirateur de cette mystification, Dorgelès, rédige un manifeste aux accents futuristes: &quot;L'excès en art est une force... Place au génie de l'éblouissement !&quot; avant de révéler l'affaire à la presse, constat d'huissier à l'appui."/>
  <tag k="name" v="Le Lapin Agile"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q1423353"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60291934"/>
  <tag k="wikimedia_commons" v="File:Panneau Lapin Agile.jpg;File:P1260946 Paris XVIII Au Lapin Agile rwk.jpg"/>
 </node>
 <node id="5290571510" visible="true" version="5" changeset="164744835" timestamp="2025-04-09T22:25:56Z" user="pyrog" uid="270456" lat="48.8881857" lon="2.3398340">
  <tag k="board_type" v="history"/>
  <tag k="check_date" v="2024-10-20"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="La vigne de Montmartre, la plus ancienne de Paris, compte 2000 pieds. Le premier cep aurait été planté par Adélaïde de Savoie, première abbesse de l'abbaye de Montmartre. Au XVIe siècle, Montmartre est situé hors de Paris. Ses habitants sont"/>
  <tag k="inscription:2" v="principalement des laboureurs. Le souvenir de certaines appellations des vignobles, telle La Goutte d'Or, perdure dans le nom des rues d'un quartier du 18e arrondissement."/>
  <tag k="name" v="Clos Montmartre"/>
  <tag k="operator" v="Ville de Paris"/>
  <tag k="panoramax" v="718255c5-4fd9-4583-bbf1-c84fe93ab693&amp;xyz=67.03/-15.74/4"/>
  <tag k="subject:wikidata" v="Q3501962"/>
  <tag k="tourism" v="information"/>
  <tag k="wikimedia_commons" v="File:Panneau Clos Montmartre - Paris XVIII (FR75) - 2024-08-04 - 2.jpg"/>
 </node>
