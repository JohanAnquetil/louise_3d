 <node id="12770443354" visible="true" version="1" changeset="165197734" timestamp="2025-04-20T14:40:24Z" user="pyrog" uid="270456" lat="48.8840409" lon="2.3405901">
  <tag k="historic" v="memorial"/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Appel du 18 juin"/>
 </node>
 <node id="12770443355" visible="true" version="2" changeset="165744749" timestamp="2025-05-03T06:06:15Z" user="pyrog" uid="270456" lat="48.8840466" lon="2.3405433">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="À la mémoire des élèves de cette école, déportés de 1942 à 1944, parce que nés juifs, victimes innocentes de la barbarie nazie et du gouvernement de vichy. Ils furent exterminés dans les camps de la mort."/>
  <tag k="inscription:2" v="Plus de 700 de ces enfants, vivaient dans le 18eme. Ne les oublions jamais. 27 janvier 2005"/>
  <tag k="memorial" v="plaque"/>
  <tag k="ref:FR:Paris:plaque" v="18456"/>
  <tag k="start_date" v="2005-01-27"/>
  <tag k="subject:wikidata" v="Q4499404"/>
 </node>
 <node id="12770443356" visible="true" version="2" changeset="165744749" timestamp="2025-05-03T06:06:15Z" user="pyrog" uid="270456" lat="48.8840774" lon="2.3402904">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Visiteur, Ici, dès le 5ème siècle après J.-C., Sainte Geneviève fit élever une chapelle dédiée à Saint Denis, premier évêque de Paris, martyrisé au 3ème siècle avec Saint Rustique et Saint Eleuthère."/>
  <tag k="inscription:2" v="C’est également ici que Saint Ignace de Loyola et ses compagnons prononcèrent, le 15 août 1534, le voeu de Montmartre qui les engageait au service de l'Eglise et qui aboutira, six ans plus tard,"/>
  <tag k="inscription:3" v="à l'approbation par le pape Paul III de l'Ordre des jésuites: la Compagnie de Jésus. La crypte, rétablie à la fin du 19ème siècle, perpétue le souvenir de ces deux événements."/>
  <tag k="material" v="marble"/>
  <tag k="memorial" v="plaque"/>
  <tag k="name" v="Martyrium de Montmartre"/>
  <tag k="ref:FR:Paris:plaque" v="18230"/>
  <tag k="wikimedia_commons" v="File:Panneau du martyre de St-Denis rue Yvonne Le Tac.jpg;File:11rueYvonneLeTac.jpg"/>
 </node>
