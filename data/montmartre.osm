 <node id="4876669168" visible="true" version="2" changeset="184825671" timestamp="2026-06-30T00:38:57Z" user="pyrog" uid="270456" lat="48.8846500" lon="2.3424096">
  <tag k="date" v="1943-12-14"/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="Dans cette école Jean Roger Debrais a appris l'amour de la patrie - Jeune F.T.P.F. il est mort pour elle le 14 décembre 1943 sous les balles de l'enemi. Il avait vingt ans"/>
  <tag k="memorial" v="plaque"/>
  <tag k="source" v="survey 2017"/>
 </node>
 <node id="4876669169" visible="true" version="2" changeset="184825671" timestamp="2026-06-30T00:38:57Z" user="pyrog" uid="270456" lat="48.8846855" lon="2.3424057">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="À la mémoire des élèves de cette école déportés de 1942 à 1944 parce que nés juifs, victimes innocentes de la barbarie nazie et du gouvernement de Vichy. Ils furent exterminés dans les camps de la mort. Plus de 700 de ces enfants vivaient dans le 18ème"/>
  <tag k="memorial" v="plaque"/>
  <tag k="source" v="survey 2017"/>
 </node>
