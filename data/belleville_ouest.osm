 <node id="11635495800" visible="true" version="2" changeset="174169193" timestamp="2025-11-03T22:29:23Z" user="Britzz" uid="7550430" lat="48.8649569" lon="2.3643107">
  <tag k="historic" v="memorial"/>
  <tag k="inscription:1" v="De 1942 à 1944, plus de 11000 enfants furent déportés de Francepar les nazis avec la participation active du Gouvernement français de Vichy et assassinés dans les camps de la mort parceque nés juifs."/>
  <tag k="inscription:2" v="Plus de 500 de ces enfants de ces enfants vivaient dans le 3ème. Nombre d'entre eux ont fréquentés les écoles élémentaires filles et garçons P.J. de Béranger. Ne les oublions jamais."/>
  <tag k="memorial" v="plaque"/>
  <tag k="start_date" v="2012-11-16"/>
 </node>
