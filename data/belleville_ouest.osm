  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="ici des milliers de volontaires français et étrangers sont passés de 1936 à 1938 pour s'enrôler dans les Brigades internationales afin d'aider la république espagnole victime du coup d'état du général Franco soutenu par Hitler et Mussolini"/>
  <tag k="memorial" v="plaque"/>
 </node>
