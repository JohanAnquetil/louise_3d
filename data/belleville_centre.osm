 <node id="5058341302" visible="true" version="1" changeset="51436041" timestamp="2017-08-25T14:21:18Z" user="Floflow" uid="3153462" lat="48.8672516" lon="2.3841533">
  <tag k="board_type" v="history"/>
  <tag k="historic" v="memorial"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="ALBERT BIGLELMAN enfant de cette école survivant de la Shoah 1944 - 1945"/>
  <tag k="memorial" v="plaque"/>
 </node>
 <node id="5058341303" visible="true" version="1" changeset="51436041" timestamp="2017-08-25T14:21:18Z" user="Floflow" uid="3153462" lat="48.8672540" lon="2.3841599">
  <tag k="board_type" v="history"/>
  <tag k="historic" v="memorial"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="À la mémoire des élèves de cette école déportés de 1942 à 1944 parce qu'ils étaient nés juifs, victimes innocentes de la barbarie nazie avec la complicité active du gouvernement de Vichy."/>
  <tag k="inscription:2" v="Ils furent exterminés dans les camps de la mort. Maternelle Ménilmontant Le 28 avril 2001"/>
  <tag k="memorial" v="plaque"/>
 </node>
 <node id="5058341304" visible="true" version="5" changeset="165457940" timestamp="2025-04-26T10:16:07Z" user="pyrog" uid="270456" lat="48.8673368" lon="2.3832497">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Ici s'ouvrait la Barrière de Belleville, un des pavillons d'entrée dans le Mur des Fermiers généraux."/>
  <tag k="inscription:2" v="Afin de mieux percevoir les impôts indirects sur les biens de consomation courante (alcool, tabac, denrées alimentaires, bois, etc.) la Ferme générale décida en 1783 d'édifier tout autour de la capitale un mur de 60 portes ou &quot;barrières&quot;,"/>
  <tag k="inscription:3" v="destinées à percevoir les droits d'octroi. Ce procédé, imaginé pour combattre la fraude, provoqua un grave mécontentement des Parisiens : &quot;le mur murant Paris rend Paris murmurant&quot;."/>
  <tag k="inscription:4" v="Sa construction fut confiée à l'architecte Claude-Nicolas Ledoux (1736-1806), qui réalisa une oeuvre imposante dont seules subsistent aujourd'hui les rotondes de Monceau et de la Villette"/>
  <tag k="inscription:5" v="et les barrières de Denfert et de la Nation. Le succès des cabarets bellevillois était en partie dû à leur situation hors du mur:"/>
  <tag k="inscription:6" v="le vin, non soumis aux taxes, y était en effet moins cher qu'à Paris."/>
  <tag k="name" v="Barrière de Belleville"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q60367162"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60291976"/>
  <tag k="wikimedia_commons" v="File:Panneau Barrière de Belleville.jpg;File:4bdBelleville situ.jpg"/>
 </node>
