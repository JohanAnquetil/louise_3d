 <node id="5197555831" visible="true" version="3" changeset="103291483" timestamp="2021-04-20T19:18:51Z" user="Britzz" uid="7550430" lat="48.8685032" lon="2.3700108">
  <tag k="board_type" v="history"/>
  <tag k="historic" v="memorial"/>
  <tag k="information" v="board"/>
  <tag k="inscription:1" v="Dans le rue de la Fontaine-au-Roi résista la dernière barricade de la Commune de Paris défendue par ses chefs: E. VARLIN, T. FERRE et J.B. CLEMENT. Elle succomba vers midi le 28 mai 1871 au terme de la &quot;Semaine Sanglante&quot;. 120 ans après, le Parti"/>
  <tag k="inscription:2" v="Socialiste et son Premier Secrétaire Pierre MAUROY, rendent hommage au Peuple de PARIS qui voulut changer la vie et aux 30.000 fusillés du &quot;temps des cerises&quot;. 28 mai 1871 / 28 mai 1991."/>
  <tag k="memorial" v="plaque"/>
  <tag k="wikidata" v="Q42401130"/>
 </node>
