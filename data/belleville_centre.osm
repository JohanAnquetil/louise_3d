 <node id="5117245069" visible="true" version="3" changeset="164714619" timestamp="2025-04-09T09:26:36Z" user="pyrog" uid="270456" lat="48.8703053" lon="2.3847486">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Nous situons ici le Cabaret du Pistolet, où fut arrêté, le 20 octobre 1721, le célèbre bandit Cartouche. Louis-Dominique Bourguignon, dit Cartouche (1663-1721), défraya la chronique judiciaire sous la Régence."/>
  <tag k="inscription:2" v="Après avoir terrorisé Paris et sa banlieue près de dix ans par ses vols et ses méfaits, commis en toute impunité apparente, il avait trouvé refuge dans ce cabaret louche, proche de la barrière de Belleville."/>
  <tag k="inscription:3" v="Surpris dans son sommeil par les sergents du Guet, jugé et condamné à mort, Cartouche fut roué vif en place de Grève, devant l'Hôtel de Ville, le 28 novembre 1721. Sa vie aventureuse inspira nombre de chansons, pièces de théâtre et récits,"/>
  <tag k="inscription:4" v="qui connurent un grand succès populaire."/>
  <tag k="name" v="Cabaret du Pistolet"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60291978"/>
  <tag k="wikimedia_commons" v="File:Cabaretdupistolet pelle.jpg;File:Cabaretdupistolet situ.jpg"/>
 </node>
 <node id="5117245070" visible="true" version="2" changeset="63737745" timestamp="2018-10-21T20:26:28Z" user="Britzz" uid="7550430" lat="48.8702660" lon="2.3844049">
  <tag k="board_type" v="history"/>
  <tag k="historic" v="memorial"/>
  <tag k="information" v="board"/>
  <tag k="inscription" v="Ici demeurait Jacques KIPMAN dit &quot;Bruno&quot; Résistant F.T.P. M.O.I. Né à Paris le 27 août 1926 Tué à Lyon le 11 juin 1944 Mort pour la France"/>
  <tag k="memorial" v="plaque"/>
  <tag k="tourism" v="information"/>
 </node>
