 <node id="14277471167" visible="true" version="1" changeset="190410980" timestamp="2026-10-12T16:22:19Z" user="Kalepom" uid="392288" lat="48.8724567" lon="2.3714664">
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="À la mémoire des élèves de cette école déportés de 1942 à 1944 parce que nés juifs, victimes innocentes de la barbarie nazie et du gouvernement de Vichy. ils furent exterminés dans les camps de la mort. Plus de 500 de ces enfants vivaient dans le 10ème."/>
  <tag k="memorial" v="plaque"/>
  <tag k="start_date" v="2001-05-19"/>
 </node>
