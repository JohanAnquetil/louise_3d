 <node id="5117285801" visible="true" version="5" changeset="164744835" timestamp="2025-04-09T22:25:56Z" user="pyrog" uid="270456" lat="48.8724448" lon="2.3785904">
  <tag k="board:title" v="Histoire de Paris"/>
  <tag k="board_type" v="history"/>
  <tag k="information" v="board"/>
  <tag k="inscription:2" v="&quot;Elle avait, écrit un contemporain, la prétention de représenter exactement une des casernes de Nouméa. On eût dit d'une prison. Au-dessus de la porte, une lanterne rouge&quot; Sur la toiture à droite et à gauche, deux canons&quot;."/>
  <tag k="inscription:3" v="On ne sortait de l'étrange établissement qui était resté &quot;la gloire de Lisbonne&quot; qu'à l'aide de ce carton vert ou jaune : CERTIFICAT DE LIBÉRATION Le Condamné a consommé et s'est bien conduit. Le Directeur M. Lisbonne"/>
  <tag k="inscription:4" v="&quot;À l'intérieur, qui était d'un minable à faire fuir, mais dans lequel on s'empilait, le service était confié à des forçats, ayant tous au pied une chaîne se terminant par un boulet."/>
  <tag k="inscription:5" v="Seulement le boulet était creux, s'accrochait à la ceinture, s'ouvrait et contenait une serviette avec laquelle on essuyait les tables. Là, le bock s'appelait un boulet.&quot;"/>
  <tag k="name" v="Taverne du bagne de Maxime Lisbonne"/>
  <tag k="operator" v="Mairie de Paris"/>
  <tag k="subject:wikidata" v="Q3302642"/>
  <tag k="tourism" v="information"/>
  <tag k="wikidata" v="Q60292009"/>
  <tag k="wikimedia_commons" v="File:MaximeLisbonne.jpg;File:12rueBelleville situ.jpg"/>
 </node>
